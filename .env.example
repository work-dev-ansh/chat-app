# Database Connection (PostgreSQL with pgBouncer or direct connection pool)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_chat"

# Auth.js / NextAuth Configuration
# Run `openssl rand -base64 32` to generate a secure 32+ character secret
AUTH_SECRET="your-32-character-auth-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Real-Time WebSocket Server
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# Google OAuth 2.0 (Optional — for Google Sign-in)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cloudinary CDN Pipeline (For production media uploads; falls back to local data URLs if unset)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""